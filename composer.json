{
    "name": "webman-tech/testing",
    "type": "library",
    "license": "MIT",
    "description": "Real-process testing toolkit for webman: server orchestration, HTTP assertions, CLI command and side-effect helpers",
    "autoload": {
        "psr-4": {
            "WebmanTech\\Testing\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/e2e-setup"
    ],
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "require": {
        "php": "^8.2",
        "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0",
        "psr/http-client": "^1.0",
        "psr/http-message": "^1.0 || ^2.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/process": "^6.4 || ^7.0"
    },
    "require-dev": {
        "guzzlehttp/guzzle": "^7.10",
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^2.1",
        "robmorgan/phinx": "^0.16",
        "webman/database": "^2.1"
    },
    "suggest": {
        "guzzlehttp/guzzle": "PSR-18 HTTP 客户端实现（安装后自动发现并使用；未安装时组件会提示）",
        "pestphp/pest": "pest 函数式测试风格（组件同时兼容 phpunit）",
        "webman/database": "数据库就绪（setUpDatabase/断言）基于被测应用的 webman/database（support\\Db），组件默认下游已安装"
    },
    "scripts": {
        "phpstan": "phpstan",
        "test": "pest",
        "test:coverage": "pest --coverage",
        "test:coverage:html": "pest --coverage --coverage-html=build/coverage",
        "e2e:install": "php bin/e2e-setup install",
        "e2e:sync": "php bin/e2e-setup sync",
        "e2e:test": "cd e2e/webman && vendor/bin/pest",
        "e2e:vcs": "php bin/e2e-setup install --vcs"
    }
}
